diff --git a/cv32e40x/tb/core/cv32e40x_tb_wrapper.sv b/cv32e40x/tb/core/cv32e40x_tb_wrapper.sv
index d882efe..e5fc4ef 100644
--- a/cv32e40x/tb/core/cv32e40x_tb_wrapper.sv
+++ b/cv32e40x/tb/core/cv32e40x_tb_wrapper.sv
@@ -67,7 +67,11 @@ module cv32e40x_tb_wrapper
 
    // eXtension Interface
     if_xif #(
+`ifdef PARAGATO_XIF_MAC
+        .X_NUM_RS    ( 3  ),   // PARAGATO: pg.mac needs rs1, rs2 and rd
+`else
         .X_NUM_RS    ( 2  ),
+`endif
         .X_MEM_WIDTH ( 32 ),
         .X_RFR_WIDTH ( 32 ),
         .X_RFW_WIDTH ( 32 ),
@@ -75,9 +79,57 @@ module cv32e40x_tb_wrapper
     ) ext_if();
 
 
+`ifdef PARAGATO_XIF_SWPI
+    // PARAGATO: post-increment store, the top candidate once CV-X-IF offload
+    // latency is charged. Uses the optional xif_mem interface.
+    pg_xif_swpi pg_xif_swpi_i (
+        .clk_i  (clk_i),
+        .rst_ni (rst_ni),
+        .xif_compressed_if (ext_if),
+        .xif_issue_if      (ext_if),
+        .xif_commit_if     (ext_if),
+        .xif_mem_if        (ext_if),
+        .xif_mem_result_if (ext_if),
+        .xif_result_if     (ext_if)
+    );
+`endif
+
+`ifdef PARAGATO_XIF_MAC
+    // PARAGATO: fused multiply-accumulate offloaded over CV-X-IF. See
+    // rtl/pg_xif_mac.sv; candidate identified by model/find_candidates.py.
+    pg_xif_mac #(.X_NUM_RS(3))
+    pg_xif_mac_i (
+        .clk_i  (clk_i),
+        .rst_ni (rst_ni),
+        .xif_compressed_if (ext_if),
+        .xif_issue_if      (ext_if),
+        .xif_commit_if     (ext_if),
+        .xif_mem_if        (ext_if),
+        .xif_mem_result_if (ext_if),
+        .xif_result_if     (ext_if)
+    );
+`endif
+
     // instantiate the core
+    // PARAGATO: the core's optional extensions are configurable parameters, but
+    // this testbench hardwired the defaults. Expose B_EXT so a benchmark can be
+    // run with and without bitmanip and the difference measured. Select with
+    // +define+PARAGATO_ZBA_ZBB_ZBS (or ..._ZBC) at Verilator compile time.
+    // Values are given numerically because the testbench sources are compiled
+    // before cv32e40x_pkg is declared, so the enum names are not yet visible.
     cv32e40x_core #(
                  .NUM_MHPMCOUNTERS (NUM_MHPMCOUNTERS)
+`ifdef PARAGATO_ZBA_ZBB_ZBC_ZBS
+                 , .B_EXT (2'd2)   // cv32e40x_pkg::ZBA_ZBB_ZBC_ZBS
+`elsif PARAGATO_ZBA_ZBB_ZBS
+                 , .B_EXT (2'd1)   // cv32e40x_pkg::ZBA_ZBB_ZBS
+`endif
+`ifdef PARAGATO_XIF_MAC
+                 , .X_EXT (1'b1)
+                 , .X_NUM_RS (3)
+`elsif PARAGATO_XIF_SWPI
+                 , .X_EXT (1'b1)     // pg.swpi needs only rs1, rs2
+`endif
                 )
     cv32e40x_core_i
         (
@@ -114,6 +166,12 @@ module cv32e40x_tb_wrapper
          .data_we_o              ( data_we               ),
          .data_be_o              ( data_be               ),
          .data_addr_o            ( data_addr             ),
+         // PARAGATO fix: data_wdata_o / data_rdata_i were not connected at all in
+         // this legacy `core` testbench, so every store wrote 0x0 and every load
+         // returned 0x0. Verilator's PINMISSING warning is suppressed by the
+         // Makefile's --Wno-lint, so this failed silently.
+         .data_wdata_o           ( data_wdata            ),
+         .data_rdata_i           ( data_rdata            ),
          .data_memtype_o         (                       ), // TODO: should the core tb check this?
          .data_prot_o            (                       ), // TODO: should the core tb check this?
          .data_dbg_o             (                       ), // TODO
@@ -199,4 +257,22 @@ module cv32e40x_tb_wrapper
          .exit_valid_o   ( exit_valid_o                              ),
          .exit_value_o   ( exit_value_o                              ));
 
+    // PARAGATO debug aid: dump the ID-stage PC every cycle when +pctrace is given.
+    // The `core` testbench instantiates cv32e40x_core directly rather than
+    // cv32e40x_wrapper, so cv32e40x_core_log (illegal-instruction logging) is never
+    // instantiated and there is no RVFI tracer available here.
+    // +pctrace   : one line per cycle, gated on if_id_pipe.instr_valid so that
+    //              stale/flushed PCs are not reported. A PC repeating on
+    //              consecutive lines therefore means a genuine ID-stage stall.
+    // +cyctrace  : same, but every cycle including invalid ones, tagged with
+    //              validity -- use when you need an exact cycle timeline.
+    always_ff @(posedge clk_i) begin: paragato_pctrace
+        if ($test$plusargs("pctrace") && cv32e40x_core_i.if_id_pipe.instr_valid)
+            $display("PC=0x%08x", cv32e40x_core_i.if_id_pipe.pc);
+        if ($test$plusargs("cyctrace"))
+            $display("CYC v=%0d PC=0x%08x",
+                     cv32e40x_core_i.if_id_pipe.instr_valid,
+                     cv32e40x_core_i.if_id_pipe.pc);
+    end
+
 endmodule // cv32e40x_tb_wrapper
